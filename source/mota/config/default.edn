{
 :logging {
   :level "INFO"
   :format "%(asctime)s - %(name)s - %(levelname)s - %(message)s"
   :output "stdout"
 }
 
 :llm {
   :default_provider "openai"
   :temperature 0.7
   :stream true
   :max_tokens 1000
   
   :providers {
     :openai {
       :model "gpt-4-turbo-preview"
       :temperature 0.7
       :stream true
     }
     :anthropic {
       :model "claude-3-sonnet"
       :temperature 0.7
       :stream true
     }
     :gemini {
       :model "gemini-pro"
       :temperature 0.7
       :stream true
     }
     :mistral {
       :model "mistral-large"
       :temperature 0.7
       :stream true
     }
     :groq {
       :model "deepseek-r1-distill-llama-70b"
       :temperature 1.236
       :stream true
     }
     :grok {
       :model "grok-model"
       :temperature 0.7
       :stream true
     }
     :deepseek {
       :model "deepseek-model"
       :temperature 0.7
       :stream true
     }
     :openrouter {
       :model "openrouter-model"
       :temperature 0.7
       :stream true
     }
   }
 }
}
